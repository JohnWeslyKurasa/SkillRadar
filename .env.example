# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is already in .gitignore.

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Create a free M0 cluster at https://cloud.mongodb.com
# Connection string format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/

MONGODB_DB_NAME=skillradar

# ── Adzuna API ─────────────────────────────────────────────────────────────────
# Register free at https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here
ADZUNA_COUNTRY=us
ADZUNA_BASE_URL=https://api.adzuna.com/v1/api/jobs
ADZUNA_RESULTS_PER_PAGE=50

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=Skill Gap Radar
APP_VERSION=1.0.0

# Set to true to enable /docs, /redoc, /openapi.json (local dev only)
DEBUG=true

# Comma-separated allowed CORS origins ("*" is fine for local dev)
CORS_ORIGINS=*

# ── Report settings ────────────────────────────────────────────────────────────
REPORT_TTL_DAYS=30
MIN_POSTINGS_THRESHOLD=10
